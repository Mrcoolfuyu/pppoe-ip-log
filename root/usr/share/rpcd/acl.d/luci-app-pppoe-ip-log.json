{
	"luci-app-pppoe-ip-log": {
		"description": "Grant access to the PPPoE IP log data and actions",
		"read": {
			"file": {
				"/etc/pppoe-ip-log/*": [ "read" ]
			},
			"uci": [ "pppoe-ip-log", "network" ]
		},
		"write": {
			"uci": [ "pppoe-ip-log" ],
			"file": {
				"/usr/sbin/pppoe-ip-log": [ "exec" ],
				"/usr/sbin/pppoe-ip-log *": [ "exec" ],
				"/etc/init.d/pppoe-ip-log": [ "exec" ],
				"/etc/init.d/pppoe-ip-log *": [ "exec" ]
			}
		}
	}
}

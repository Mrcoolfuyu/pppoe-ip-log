#!/bin/sh
# pppoe-ip-log - record public IP address changes of PPPoE / WAN interfaces
#
# Records the time, the previous address and the new address whenever the
# public IPv4 address of a monitored (PPPoE) interface changes. In addition to
# the interface address it can also discover the public-facing address by
# querying an external echo service (useful when the WAN sits behind CGNAT and
# only a 100.64.0.0/10 carrier-grade NAT address is visible locally).
#
# Copyright (C) 2026  WorkBuddy
# Released under the Apache License, Version 2.0

. /lib/functions.sh
. /lib/functions/network.sh

NAME="pppoe-ip-log"
UCI_CFG="pppoe-ip-log"
DATA_DIR="/etc/pppoe-ip-log"
LOG_FILE="$DATA_DIR/history.log"
STATE_FILE="$DATA_DIR/state"
STATUS_FILE="$DATA_DIR/status.json"
LOCK_DIR="/var/lock/$NAME"
LOCK_TRIES=60

conf_get() {
	uci -q get "$UCI_CFG.main.$1" 2>/dev/null
}

is_enabled() {
	[ "$(conf_get enabled)" != "0" ]
}

lock_acquire() {
	local i=0 hp
	while true; do
		if mkdir "$LOCK_DIR" 2>/dev/null; then
			echo $$ > "$LOCK_DIR/pid"
			return 0
		fi
		# Lock already held - find out whether the holder is still alive.
		hp="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
		if [ -n "$hp" ] && kill -0 "$hp" 2>/dev/null; then
			# Live holder: wait, bounded by LOCK_TRIES.
			i=$((i + 1))
			[ "$i" -ge "$LOCK_TRIES" ] && return 1
			sleep 1
		else
			# Stale lock left behind by a dead process: clear and retry.
			rm -rf "$LOCK_DIR" 2>/dev/null
		fi
	done
	return 1
}

lock_release() {
	rm -f "$LOCK_DIR/pid" 2>/dev/null
	rmdir "$LOCK_DIR" 2>/dev/null
}

# --- interface selection ---------------------------------------------------

pppoe_iface_cb() {
	local proto
	config_get proto "$1" proto
	[ "$proto" = "pppoe" ] && echo "$1"
}

monitored_interfaces() {
	local cfg iface found

	cfg="$(conf_get interface)"
	if [ -n "$cfg" ] && [ "$cfg" != "auto" ]; then
		for iface in $cfg; do
			[ -n "$iface" ] && echo "$iface"
		done
		return 0
	fi

	found="$(config_load network; config_foreach pppoe_iface_cb interface)"
	if [ -n "$found" ]; then
		echo "$found"
		return 0
	fi

	# nothing detected - fall back to the default WAN interface
	echo "wan"
}

# --- helpers ---------------------------------------------------------------

interface_ip() {
	local addr=""
	network_get_ipaddr addr "$1" 2>/dev/null
	[ -n "$addr" ] && echo "$addr"
}

# Fetch a URL and print the first IPv4 address found in the body.
fetch_url() {
	local url="$1" out=""

	if command -v uclient-fetch >/dev/null 2>&1; then
		out="$(uclient-fetch -q -T 4 -O - "$url" 2>/dev/null)"
	elif command -v wget >/dev/null 2>&1; then
		out="$(wget -q -T 4 -O - "$url" 2>/dev/null)"
	elif command -v curl >/dev/null 2>&1; then
		out="$(curl -s --max-time 4 "$url" 2>/dev/null)"
	fi

	[ -n "$out" ] && echo "$out" | grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' | head -1
}

# Discover the public-facing IPv4 address. Returns empty when the lookup is
# disabled or every echo URL fails (so the caller just logs the interface IP).
public_ip() {
	local urls url ip

	[ "$(conf_get public_ip_lookup)" = "0" ] && return 0

	urls="$(conf_get echo_url)"
	[ -n "$urls" ] || urls="http://api.ipify.org http://ifconfig.me/ip http://ipinfo.io/ip http://ipecho.net/plain https://api.ipify.org"

	for url in $urls; do
		ip="$(fetch_url "$url")"
		[ -n "$ip" ] && { echo "$ip"; return 0; }
	done

	return 0
}

# Report the installed package version (taken from the opkg control file).
# Returns empty when the control file is unavailable.
pkg_version() {
	local f="/usr/lib/opkg/info/luci-app-pppoe-ip-log.control"
	[ -f "$f" ] && sed -n 's/^Version: //p' "$f" 2>/dev/null
}

state_field() {
	# $1 = interface, $2 = field (2 = ifaddr, 3 = public addr, 4 = unix ts)
	[ -f "$STATE_FILE" ] || return 0
	awk -v iface="$1" -v field="$2" '$1 == iface { print $field; exit }' "$STATE_FILE"
}

state_update() {
	local iface="$1" ifaddr="$2" pubaddr="$3" ts="$4" tmp="$STATE_FILE.tmp"

	if [ -f "$STATE_FILE" ]; then
		grep -v "^$iface " "$STATE_FILE" > "$tmp" 2>/dev/null
	else
		: > "$tmp"
	fi
	printf '%s %s %s %s\n' "$iface" "$ifaddr" "$pubaddr" "$ts" >> "$tmp"
	mv "$tmp" "$STATE_FILE"
}

fmt_ts() {
	local ts="$1" out
	out="$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	[ -n "$out" ] || out="-"
	echo "$out"
}

trim_log() {
	local max lines
	max="$(conf_get max_entries)"
	case "$max" in
		''|*[!0-9]*) max=500 ;;
	esac
	[ "$max" -gt 0 ] || return 0
	[ -f "$LOG_FILE" ] || return 0

	lines=$(wc -l < "$LOG_FILE" 2>/dev/null)
	case "$lines" in
		''|*[!0-9]*) return 0 ;;
	esac
	[ "$lines" -gt "$max" ] || return 0

	tail -n "$max" "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
}

# history.log columns: epoch  datestr  iface  old_pub  new_pub  old_if  new_if
log_change() {
	local iface="$1" old_if="$2" old_pub="$3" new_if="$4" new_pub="$5" ts="$6"

	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$ts" "$(fmt_ts "$ts")" "$iface" \
		"${old_pub:--}" "${new_pub:--}" \
		"${old_if:--}" "${new_if:--}" >> "$LOG_FILE"

	logger -t "$NAME" "interface $iface IP changed: if ${old_if:-none}->${new_if:-none}, public ${old_pub:-none}->${new_pub:-none}" 2>/dev/null

	trim_log
}

# --- status.json -----------------------------------------------------------

status_write() {
	# $1 = unix timestamp of this run, $2 = temp file with "iface ifaddr pubaddr ts" lines
	local now="$1" entries="$2" tmp="$STATUS_FILE.tmp" out first=1 iface ifaddr pubaddr ts
	local ver="$(pkg_version)" pl=0 pa

	# Tell the UI whether the public-address columns should be shown at all.
	[ "$(conf_get public_ip_lookup)" != "0" ] && pl=1

	out="{\"now\":$now,\"version\":\"$ver\",\"public_lookup\":$pl,\"interfaces\":["
	while read -r iface ifaddr pubaddr ts; do
		[ -n "$iface" ] || continue
		pa="$pubaddr"
		[ "$pa" = "-" ] && pa=""
		[ "$first" = "1" ] || out="$out,"
		first=0
		if [ -z "$ifaddr" ] || [ "$ifaddr" = "-" ]; then
			out="$out{\"interface\":\"$iface\",\"address\":\"\",\"public_address\":\"\",\"changed\":0,\"changed_str\":\"-\",\"up\":false}"
		else
			out="$out{\"interface\":\"$iface\",\"address\":\"$ifaddr\",\"public_address\":\"$pa\",\"changed\":${ts:-0},\"changed_str\":\"$(fmt_ts "$ts")\",\"up\":true}"
		fi
	done < "$entries"
	out="$out]}"
	if [ -n "$out" ]; then
		printf '%s' "$out" > "$tmp" && mv "$tmp" "$STATUS_FILE"
	fi
}

# --- actions ---------------------------------------------------------------

do_check() {
	local now iface ifaddr old_if old_pub old_ts pubaddr new_pub entries="$DATA_DIR/.entries.tmp"

	mkdir -p "$DATA_DIR"
	: > "$entries"

	now="$(date +%s)"
	network_flush_cache

	# The public address is per-router, not per-interface, so query it once.
	# When the lookup is disabled (or every echo URL fails) use "-" as a
	# placeholder: an empty field would collapse this column in the state and
	# entries files, shifting the timestamp into the public-address slot.
	pubaddr="-"
	if [ "$(conf_get public_ip_lookup)" != "0" ]; then
		local pip
		pip="$(public_ip)"
		[ -n "$pip" ] && pubaddr="$pip"
	fi

	for iface in $(monitored_interfaces); do
		ifaddr="$(interface_ip "$iface")"

		if [ -z "$ifaddr" ]; then
			# interface has no address (down) - keep the last known state
			old_ts="$(state_field "$iface" 4)"
			printf '%s %s %s %s\n' "$iface" "-" "-" "${old_ts:-0}" >> "$entries"
			continue
		fi

		# Read previous state. Tolerate the legacy 3-column format written
		# by r1 ("iface ifaddr ts"), which has no public-address column, so
		# that upgrading from r1 does not misread the old timestamp as a
		# public address.
		local sline sf
		sline="$(awk -v i="$iface" '$1==i{print;exit}' "$STATE_FILE" 2>/dev/null)"
		sf="$(printf '%s' "$sline" | wc -w)"
		if [ "$sf" = "3" ]; then
			old_if="$(printf '%s' "$sline" | awk '{print $2}')"
			old_pub=""
			old_ts="$(printf '%s' "$sline" | awk '{print $3}')"
		else
			old_if="$(printf '%s' "$sline" | awk '{print $2}')"
			old_pub="$(printf '%s' "$sline" | awk '{print $3}')"
			old_ts="$(printf '%s' "$sline" | awk '{print $4}')"
		fi
		[ "$old_pub" = "-" ] && old_pub=""

		new_pub="$pubaddr"
		[ "$new_pub" = "-" ] && new_pub=""

		if [ "$ifaddr" != "$old_if" ] || [ "$new_pub" != "$old_pub" ]; then
			log_change "$iface" "$old_if" "$old_pub" "$ifaddr" "$pubaddr" "$now"
			state_update "$iface" "$ifaddr" "$pubaddr" "$now"
			old_ts="$now"
		fi

		printf '%s %s %s %s\n' "$iface" "$ifaddr" "$pubaddr" "${old_ts:-$now}" >> "$entries"
	done

	status_write "$now" "$entries"
	rm -f "$entries"
}

do_clear() {
	mkdir -p "$DATA_DIR"
	: > "$LOG_FILE"
	: > "$STATE_FILE"
	do_check
}

do_daemon() {
	local interval
	interval="$(conf_get interval)"
	case "$interval" in
		''|*[!0-9]*) interval=30 ;;
	esac
	[ "$interval" -ge 1 ] || interval=30

	while :; do
		is_enabled || exit 0
		if lock_acquire; then
			do_check
			lock_release
		fi
		sleep "$interval"
	done
}

do_status() {
	[ -f "$STATUS_FILE" ] && cat "$STATUS_FILE"
	echo
}

usage() {
	echo "Usage: $0 {check|clear|daemon|status|interfaces}" >&2
	exit 1
}

case "$1" in
	check)
		is_enabled || exit 0
		lock_acquire && { do_check; lock_release; }
		;;
	clear)
		lock_acquire && { do_clear; lock_release; }
		;;
	daemon)
		do_daemon
		;;
	status)
		do_status
		;;
	interfaces)
		monitored_interfaces
		;;
	*)
		usage
		;;
esac

exit 0
